# =============================================================================
# Multi-Environment Support
# Copy this file to .env (or .env.dev / .env.qas / .env.preprod)
# Then run: ENV=qas npm test
# =============================================================================
ENV=dev

# =============================================================================
# SAP S/4HANA / Fiori connection (REQUIRED)
# =============================================================================
SAP_CLOUD_BASE_URL=https://your-s4-system.sap.ondemand.com
SAP_CLOUD_USERNAME=your_username
SAP_CLOUD_PASSWORD=your_password

# Auth strategy: basic | btp-saml | office365 | custom
SAP_AUTH_STRATEGY=basic

# Optional SAP logon parameters
SAP_CLIENT=100
SAP_LANGUAGE=EN

# =============================================================================
# Test Master Data (override per environment)
# =============================================================================
TEST_COMPANY_CODE=1000
TEST_PLANT=1000
TEST_SALES_ORG=1000
TEST_PURCH_ORG=1000
TEST_COST_CENTER=1000
TEST_CUSTOMER=1000
TEST_VENDOR=100001
TEST_MATERIAL=MAT-001

# =============================================================================
# Praman runtime
# =============================================================================
PRAMAN_LOG_LEVEL=info
# PRAMAN_SKIP_VERSION_CHECK=true

# =============================================================================
# Optional: AI providers for plan → generate → heal agents
# =============================================================================
# PRAMAN_AI_PROVIDER=anthropic
# PRAMAN_AI_API_KEY=sk-...
# PRAMAN_AI_MODEL=claude-sonnet-4-20250514
# PRAMAN_AI_ENDPOINT=https://your-azure-openai.openai.azure.com
# PRAMAN_AI_DEPLOYMENT=gpt-4o
# PRAMAN_AI_API_VERSION=2024-08-01-preview
# PRAMAN_AI_ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Optional: OpenTelemetry / observability
# =============================================================================
# PRAMAN_TELEMETRY_ENABLED=true
# PRAMAN_TELEMETRY_ENDPOINT=http://localhost:4318
# PRAMAN_TELEMETRY_SERVICE_NAME=sap-s4-praman
# PRAMAN_TELEMETRY_EXPORTER=otlp
# PRAMAN_ODATA_TRACING_ENABLED=true

# =============================================================================
# Optional: ReportPortal (historical trends + flaky detection)
# When both RP_ENDPOINT and RP_API_KEY are set, the agent is enabled automatically.
# =============================================================================
# RP_ENDPOINT=https://your.reportportal.server/api/v2
# RP_API_KEY=your-api-key
# RP_PROJECT=sap-s4-praman
# RP_LAUNCH=SAP S/4 E2E – qas
