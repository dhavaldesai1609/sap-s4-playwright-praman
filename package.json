{
  "name": "sap-s4-playwright-praman",
  "version": "1.3.0",
  "description": "Playwright Praman framework for SAP S/4HANA – OTC/PTP/RTR/ATR/HTR with visual regression, Allure history/TestOps and optional ReportPortal",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:otc": "playwright test tests/e2e/otc",
    "test:ptp": "playwright test tests/e2e/ptp",
    "test:rtr": "playwright test tests/e2e/rtr",
    "test:atr": "playwright test tests/e2e/atr",
    "test:htr": "playwright test tests/e2e/htr",
    "test:high": "playwright test --grep @high",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "test:samples": "playwright test tests/sample-tests",
    "report": "playwright show-report",
    "report:allure": "node scripts/prepare-allure-history.mjs && allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:allure:generate": "node scripts/prepare-allure-history.mjs && allure generate allure-results --clean -o allure-report",
    "report:compliance": "echo 'Open reports/ folder: compliance-report.json + odata-trace.json'",
    "init": "npx playwright-praman init",
    "auth:setup": "playwright test --project=setup",
    "ci": "playwright test --reporter=list"
  },
  "keywords": [
    "playwright",
    "praman",
    "sap",
    "s4hana",
    "visual-regression",
    "allure",
    "reportportal",
    "otc",
    "ptp",
    "rtr"
  ],
  "author": "Dhaval Desai",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@reportportal/agent-js-playwright": "5.1.9",
    "@types/node": "22.10.0",
    "allure-commandline": "2.32.0",
    "allure-playwright": "3.0.6",
    "dotenv": "16.4.7",
    "playwright-praman": "1.3.5",
    "typescript": "5.7.2"
  }
}
