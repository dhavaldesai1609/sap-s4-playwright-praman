{
  "name": "sap-s4-playwright-praman",
  "version": "1.0.0",
  "description": "Playwright Praman framework for SAP S/4HANA implementation - full latest functionality: UI5 typed controls, OData V2/V4, Fiori Elements, AI plan-generate-heal agents, multi-auth strategies, compliance reporting",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "init": "npx playwright-praman init",
    "auth:setup": "playwright test --project=setup"
  },
  "keywords": [
    "playwright",
    "praman",
    "sap",
    "s4hana",
    "fiori",
    "ui5",
    "odata",
    "e2e",
    "test-automation",
    "ai-agents"
  ],
  "author": "Dhaval Desai",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "playwright-praman": "^1.3.5",
    "typescript": "^5.6.0"
  }
}
